

import numpy as np
import matplotlib.pyplot as plt


class LinearRegressionGD:

    def __init__(self, learning_rate=0.00001, n_iters=100):
        self.learning_rate = learning_rate
        self.n_iters = n_iters
        self.theta_0 = 0.0
        self.theta_1 = 0.0
        self.cost_values = []

    def fit(self, x, y):
        for i in range(self.n_iters):

            y_hat = self.theta_1 * x + self.theta_0

            error = y_hat - y

            d_w = np.mean(error * x)
            d_b = np.mean(error)

            self.theta_1 = self.theta_1 - self.learning_rate * d_w
            self.theta_0 = self.theta_0 - self.learning_rate * d_b

            cost = 0.5 * np.mean((y_hat - y) ** 2)

            self.cost_values.append(cost)

            if (i + 1) % 100 == 0 or i == 0:
                print(
                    f"Epoch {i + 1}: "
                    f"Cost = {cost:.4f}, "
                    f"w = {self.theta_1:.4f}, "
                    f"b = {self.theta_0:.4f}"
                )

    def predict(self, x):
        return self.theta_1 * x + self.theta_0

    def plot_training(self, x, y):
        plt.figure(figsize=(12, 5))

        plt.subplot(1, 2, 1)

        plt.scatter(x, y, label="Data")

        plt.plot(
            x,
            self.theta_1 * x + self.theta_0,
            "r",
            label="Regression Line"
        )

        plt.title("Linear Regression")
        plt.xlabel("X")
        plt.ylabel("Y")
        plt.grid()
        plt.legend()

        plt.subplot(1, 2, 2)

        plt.plot(self.cost_values)

        plt.title("Cost vs Epochs")
        plt.xlabel("Epoch")
        plt.ylabel("Cost")
        plt.grid()

        plt.tight_layout()
        plt.show()


x = np.array([50, 60, 70, 80, 90])
y = np.array([150, 180, 210, 240, 270])

model = LinearRegressionGD(
    learning_rate=0.00001,
    n_iters=100
)

model.fit(x, y)

print("\nFinal Parameters:")
print(f"w: {model.theta_1}")
print(f"b: {model.theta_0}")

house_size = 70

prediction = model.predict(house_size)

print("\nPrediction:")
print(f"House size: {house_size} m²")
print(f"Prediction: {prediction}")

model.plot_training(x, y)
